<body>
<header><strong>Treningsplan</strong><span id="userInfo"></span></header>
<main>
<div id="message" class="message hidden" role="status" aria-live="polite"></div>
<p id="loading" class="muted">Laster …</p>
<section id="authView" class="card auth hidden"><h2>Velkommen</h2><p class="muted">Logg inn for å planlegge treningen din.</p><form id="authForm"><label>E-post<input id="email" type="email" autocomplete="email" required></label><label>Passord<input id="pw" type="password" autocomplete="current-password" minlength="6" required></label><div class="actions"><button type="submit">Logg inn</button><button type="button" id="signup" class="secondary">Opprett konto</button></div></form></section>
<div id="appView" class="hidden">
<section class="card"><h2>Mine planer</h2><div id="planList"></div><details class="section-space"><summary>Opprett ny plan</summary><form id="planForm" class="section-space"><div class="row"><label>Navn<input id="planName" required maxlength="160"></label><label>Fra<input id="planStart" type="date" required></label><label>Til<input id="planEnd" type="date" required></label><button type="submit">Opprett plan</button></div></form></details></section>
<div id="planView" class="hidden">
<section class="card"><h2 id="planTitle"></h2><p id="planPeriod" class="muted"></p><div id="planStats" class="stats"></div></section>
<section class="card">
<div class="calendar-toolbar"><div><h2 id="calendarTitle"></h2><div id="calendarCaption" class="muted"></div></div><div class="actions"><button id="weekView" class="secondary" type="button">Uke</button><button id="monthView" class="secondary" type="button">Måned</button><button id="previous" class="secondary" type="button">← Forrige</button><button id="today" class="secondary" type="button">I dag</button><button id="next" class="secondary" type="button">Neste →</button></div></div>
<p class="muted mobile-note">I månedsvisningen kan du sveipe sidelengs for å se hele uken.</p>
<div class="calendar-scroll"><div id="calendarGrid" class="calendar-grid"></div></div><div id="calendarLegend" class="legend"></div>
</section>
<section class="card" id="analysisSection">
<h2>Planlagt ukentlig volum</h2><p class="muted">Stablede søyler viser fordelingen mellom idrettene. Klikk på en søyle for å åpne uken i kalenderen. Filtrene påvirker bare analysen, ikke kalenderen.</p>
<div class="row"><label>Måleenhet<select id="metric"><option value="time">Tid (timer)</option><option value="distance">Distanse (km)</option></select></label><label>Fra dato<input id="analysisStart" type="date"></label><label>Til dato<input id="analysisEnd" type="date"></label><button type="button" id="wholePlan" class="secondary">Hele planen</button><button type="button" id="visiblePeriod" class="secondary">Kalenderperioden</button></div>
<div id="sportFilters" class="filters"></div><div class="actions"><button id="allSports" class="secondary small" type="button">Velg alle</button><button id="noSports" class="secondary small" type="button">Fjern alle</button></div>
<div id="distanceNote" class="note hidden section-space">Kilometer fra ulike idretter er ikke direkte sammenlignbare. Bruk helst én idrett om gangen for distanse, eller velg tid for samlet treningsvolum. Svømming vises også i kilometer.</div>
<div id="analysisStats" class="stats"></div><p id="analysisNote" class="muted" aria-live="polite"></p><div id="volumeChart" class="chart-scroll"></div><div id="chartLegend" class="legend"></div>
<details class="section-space"><summary>Se uketall og fordeling som tabell</summary><div class="table-scroll"><table><thead id="weeklyHead"></thead><tbody id="weeklyBody"></tbody></table></div></details>
</section>
<section id="sessionEditor" class="card"><h3 id="editorTitle">Legg til økt</h3><form id="sessionForm"><div class="form-grid"><label>Dato<input id="sDate" type="date" required></label><label>Idrett<select id="sSport"></select></label><label>Varighet i minutter<input id="sMin" type="number" min="0" step="1" placeholder="60"></label><label>Distanse i km<input id="sKm" type="number" min="0" step="0.001" placeholder="10 eller 0,4 for 400 m"></label><label class="wide">Beskrivelse<textarea id="sTitle" maxlength="4000" placeholder="F.eks. rolig løpetur eller 5 × 6 minutter intervall"></textarea></label></div><div class="actions section-space"><button id="saveSession" type="submit">Legg til økt</button><button id="cancelEdit" type="button" class="secondary hidden">Avbryt</button></div></form></section>
<section class="card"><details><summary>Plan sammenlignet med registrerte aktiviteter</summary><p class="muted">Koblinger foreslås ut fra samme dato og idrett. Mengdestatus betyr minst 90 % av planlagt distanse, eller tid dersom distanse ikke er angitt. Intensitet vurderes ikke. Flere like økter samme dag kan bli koblet feil.</p><div class="table-scroll"><table><thead><tr><th>Dato</th><th>Idrett</th><th>Økt</th><th>Planlagt</th><th>Registrert</th><th>Mengdestatus</th></tr></thead><tbody id="compareBody"></tbody></table></div></details></section>
<section class="card"><details><summary>Importerte aktiviteter uten foreslått kobling</summary><div id="unmatched"></div></details></section>
</div>
<section class="card"><details><summary>Importer aktiviteter fra Garmin Connect</summary><p class="muted">Manuell TCX-import. Automatisk Garmin-synk er ikke koblet til. Eksporter en aktivitet som TCX fra Garmin Connect hvis formatet er tilgjengelig. Andre idretter enn løping og sykling kan bli registrert som «Annet». Datoen beregnes i nettleserens tidssone.</p><label>Velg TCX-filer<input id="fileInput" type="file" accept=".tcx" multiple></label></details></section>
<button id="logout" class="secondary" type="button">Logg ut</button>
</div>
</main>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<script>
'use strict';
const SUPABASE_URL='https://psndaqabbwbecuyrnjgy.supabase.co';
const SUPABASE_KEY='sb_publishable_SOTnuKNTheOBm4Z3n3_76w_epS6ZOco';
const SPORTS=['Løping','Sykling','Svømming','Styrke','Langrenn','Annen utholdenhet','Annet'];
const COLORS={'Løping':'#15803d','Sykling':'#1d4ed8','Svømming':'#087e8b','Styrke':'#7e22ce','Langrenn':'#b45309','Annen utholdenhet':'#be185d','Annet':'#475569'};
const ICONS={'Løping':'🏃','Sykling':'🚴','Svømming':'🏊','Styrke':'🏋️','Langrenn':'🎿','Annen utholdenhet':'⛰️','Annet':'⭐'};
const $=id=>document.getElementById(id);
let sb,user=null,plans=[],currentPlan=null,sessions=[],activities=[],anchor=null,calendarMode='week',editingId=null;
let listRequest=0,planRequest=0,authBusy=false,saving=false,creating=false;
let selectedSports=new Set(SPORTS);
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function show(text,error=false){$('message').textContent=text;$('message').className='message '+(error?'error':'success');}
function fail(e){show(e?.message||String(e),true);}
function run(action){Promise.resolve().then(action).catch(fail);}
function bind(id,event,fn){$(id).addEventListener(event,e=>run(()=>fn(e)));}
function dateKey(d){return [d.getFullYear(),String(d.getMonth()+1).padStart(2,'0'),String(d.getDate()).padStart(2,'0')].join('-');}
function parseDate(s){const [y,m,d]=s.split('-').map(Number);return new Date(y,m-1,d,12);}
function addDays(d,n){const c=new Date(d);c.setDate(c.getDate()+n);return c;}
function monday(d){return addDays(d,-((d.getDay()+6)%7));}
function labelDate(s){return parseDate(s).toLocaleDateString('nb-NO',{day:'numeric',month:'short',year:'numeric'});}
function number(v,d=1){return Number(v||0).toLocaleString('nb-NO',{maximumFractionDigits:d});}
function duration(v){const n=Math.round(Number(v)||0),h=Math.floor(n/60),m=n%60;return h?`${h} t${m?' '+m+' min':''}`:`${m} min`;}
function metrics(km,min){const a=[];if(min!=null)a.push(duration(min));if(km!=null)a.push(number(km,3)+' km');return a.join(' · ')||'Ingen mengde angitt';}
function optional(v){if(!v.trim())return null;const n=Number(v);if(!Number.isFinite(n)||n<0)throw Error('Varighet og distanse må være gyldige, ikke-negative tall.');return n;}
function sportLabel(s){return (ICONS[s]||'⭐')+' '+s;}
function button(text,cls,action){const b=document.createElement('button');b.type='button';b.textContent=text;b.className=cls;b.addEventListener('click',()=>run(action));return b;}
function stats(id,items){$(id).replaceChildren();for(const [label,value] of items){const box=document.createElement('div');box.className='stat';box.textContent=label;const b=document.createElement('b');b.textContent=value;box.append(b);$(id).append(box);}}
function isoWeek(d){const t=new Date(Date.UTC(d.getFullYear(),d.getMonth(),d.getDate()));t.setUTCDate(t.getUTCDate()+4-(t.getUTCDay()||7));const y=t.getUTCFullYear();return {year:y,week:Math.ceil((((t-new Date(Date.UTC(y,0,1)))/86400000)+1)/7)};}
function resetEditor(){editingId=null;$('editorTitle').textContent='Legg til økt';$('saveSession').textContent='Legg til økt';$('cancelEdit').classList.add('hidden');$('sTitle').value='';$('sKm').value='';$('sMin').value='';}
function clearPlan(){planRequest++;currentPlan=null;sessions=[];activities=[];anchor=null;$('planView').classList.add('hidden');$('sessionForm').reset();resetEditor();}
function applyUser(next){const changed=user?.id!==next?.id;user=next;$('loading').classList.add('hidden');$('authView').classList.toggle('hidden',!!user);$('appView').classList.toggle('hidden',!user);$('userInfo').textContent=user?.email||'';if(changed){listRequest++;plans=[];$('planList').replaceChildren();clearPlan();$('pw').value='';if(user)run(loadPlans);}}
async function auth(signup){if(authBusy||!$('authForm').reportValidity())return;authBusy=true;$('authForm').querySelectorAll('button').forEach(b=>b.disabled=true);try{const credentials={email:$('email').value.trim(),password:$('pw').value};const {data,error}=signup?await sb.auth.signUp(credentials):await sb.auth.signInWithPassword(credentials);if(error)throw error;if(data.session){applyUser(data.session.user);show(signup?'Konto opprettet. Du er logget inn.':'Du er logget inn.');}else if(signup)show('Registrering sendt. Hvis e-postbekreftelse er aktivert, må kontoen bekreftes før innlogging.');}finally{authBusy=false;$('authForm').querySelectorAll('button').forEach(b=>b.disabled=false);}}
async function loadPlans(){if(!user)return;const uid=user.id,request=++listRequest;const {data,error}=await sb.from('plans').select('*').eq('user_id',uid).order('start_date',{ascending:false});if(request!==listRequest||user?.id!==uid)return;if(error)throw error;plans=data||[];$('planList').replaceChildren();if(!plans.length)$('planList').textContent='Ingen planer ennå. Opprett en nedenfor.';for(const p of plans){const row=document.createElement('div');row.className='plan-item';const description=document.createElement('div');description.innerHTML=`<div class="plan-name">${esc(p.name)}</div><div class="muted">${esc(labelDate(p.start_date))} – ${esc(labelDate(p.end_date))}</div>`;const a=document.createElement('div');a.className='actions';a.append(button('Åpne','small',()=>openPlan(p.id)),button('Slett','small danger',()=>deletePlan(p.id)));row.append(description,a);$('planList').append(row);}}
async function createPlan(e){e.preventDefault();if(creating||!user)return;const name=$('planName').value.trim(),start=$('planStart').value,end=$('planEnd').value;if(!name)throw Error('Skriv et navn på planen.');if(end<start)throw Error('Sluttdato kan ikke være før startdato.');creating=true;const b=$('planForm').querySelector('button');b.disabled=true;try{const {data,error}=await sb.from('plans').insert({user_id:user.id,name,start_date:start,end_date:end}).select().single();if(error)throw error;$('planForm').reset();await loadPlans();await openPlan(data.id);show('Planen er opprettet.');}finally{creating=false;b.disabled=false;}}
async function deletePlan(id){if(!confirm('Slette planen og alle planlagte økter? Importerte aktiviteter beholdes.'))return;const {error}=await sb.from('plans').delete().eq('id',id);if(error)throw error;if(currentPlan?.id===id)clearPlan();await loadPlans();show('Planen er slettet.');}
// Hent alle sider, slik at lange planer ikke stopper ved API-ets radgrense.
async function allRows(query){const result=[];const page=500;for(let from=0;;from+=page){const {data,error}=await query.range(from,from+page-1);if(error)throw error;result.push(...data);if(data.length<page)break;}return result;}
async function openPlan(id){const p=plans.find(x=>x.id===id);if(!p||!user)return;const uid=user.id,request=++planRequest;const [s,a]=await Promise.all([allRows(sb.from('sessions').select('*').eq('plan_id',id).eq('user_id',uid).order('date').order('id')),allRows(sb.from('activities').select('*').eq('user_id',uid).gte('date',p.start_date).lte('date',p.end_date).order('started_at').order('id'))]);if(request!==planRequest||user?.id!==uid)return;const changed=currentPlan?.id!==id;currentPlan=p;sessions=s;activities=a;if(changed){const now=dateKey(new Date());const initial=now>=p.start_date&&now<=p.end_date?now:p.start_date;anchor=parseDate(initial);$('sDate').value=initial;resetEditor();$('analysisStart').value=p.start_date;$('analysisEnd').value=p.end_date;selectedSports=new Set(SPORTS);updateFilterChecks();}$('sDate').min=p.start_date;$('sDate').max=p.end_date;for(const key of ['analysisStart','analysisEnd']){$(key).min=p.start_date;$(key).max=p.end_date;}$('planView').classList.remove('hidden');$('planTitle').textContent=p.name;$('planPeriod').textContent=labelDate(p.start_date)+' – '+labelDate(p.end_date);stats('planStats',[['Planlagte økter',sessions.length],['Planlagt tid i hele planen',duration(sessions.reduce((n,s)=>n+Number(s.planned_min||0),0))],['Importerte aktiviteter',activities.length],['Registrert tid i perioden',duration(activities.reduce((n,a)=>n+Number(a.duration_min||0),0))]]);renderCalendar();renderAnalysis();renderComparison();}
function prepareSession(date){resetEditor();$('sDate').value=date;$('sessionEditor').scrollIntoView({behavior:'smooth',block:'start'});$('sTitle').focus({preventScroll:true});}
function editSession(id){const s=sessions.find(x=>x.id===id);if(!s)return;editingId=id;$('editorTitle').textContent='Rediger økt';$('saveSession').textContent='Lagre endringer';$('cancelEdit').classList.remove('hidden');$('sDate').value=s.date;$('sSport').value=s.sport;$('sTitle').value=s.title||'';$('sMin').value=s.planned_min??'';$('sKm').value=s.planned_km??'';$('sessionEditor').scrollIntoView({behavior:'smooth',block:'start'});}
function copySession(id){editSession(id);editingId=null;$('editorTitle').textContent='Kopier økt – velg dato';$('saveSession').textContent='Opprett kopi';$('sDate').focus({preventScroll:true});}
async function saveSession(e){e.preventDefault();if(!user||!currentPlan||saving)return;saving=true;$('saveSession').disabled=true;try{const id=currentPlan.id,date=$('sDate').value;if(date<currentPlan.start_date||date>currentPlan.end_date)throw Error('Øktdatoen må være innenfor planperioden.');const row={plan_id:id,user_id:user.id,date,sport:$('sSport').value,title:$('sTitle').value.trim(),planned_min:optional($('sMin').value),planned_km:optional($('sKm').value)};const edited=!!editingId;const {error}=await(edited?sb.from('sessions').update(row).eq('id',editingId):sb.from('sessions').insert(row));if(error)throw error;resetEditor();anchor=parseDate(date);await openPlan(id);$('sDate').value=date;show(edited?'Økten er oppdatert.':'Økten er lagt til.');}finally{saving=false;$('saveSession').disabled=false;}}
async function deleteSession(id){if(!currentPlan||!confirm('Slette denne økten?'))return;const p=currentPlan.id;const {error}=await sb.from('sessions').delete().eq('id',id);if(error)throw error;if(editingId===id)resetEditor();await openPlan(p);show('Økten er slettet.');}
function calendarRange(){if(calendarMode==='week'){const start=monday(anchor);return {start,end:addDays(start,6)};}return {start:new Date(anchor.getFullYear(),anchor.getMonth(),1,12),end:new Date(anchor.getFullYear(),anchor.getMonth()+1,0,12)};}
function moveCalendar(n){if(!anchor)return;anchor=calendarMode==='week'?addDays(anchor,n*7):new Date(anchor.getFullYear(),anchor.getMonth()+n,1,12);renderCalendar();}
function renderCalendar(){if(!currentPlan||!anchor)return;const range=calendarRange();const firstKey=dateKey(range.start),lastKey=dateKey(range.end);const visible=sessions.filter(s=>s.date>=firstKey&&s.date<=lastKey);const minutes=visible.reduce((n,s)=>n+Number(s.planned_min||0),0);const missing=visible.filter(s=>s.planned_min==null).length;const iw=isoWeek(range.start);$('calendarTitle').textContent=calendarMode==='month'?anchor.toLocaleDateString('nb-NO',{month:'long',year:'numeric'}):`Uke ${iw.week} · ${labelDate(firstKey)} – ${labelDate(lastKey)}`;$('calendarCaption').textContent=`${visible.length} økter · ${duration(minutes)} angitt`+(missing?` · ${missing} uten varighet`:'');for(const [id,mode]of [['weekView','week'],['monthView','month']]){$(id).className=calendarMode===mode?'active':'secondary';$(id).setAttribute('aria-pressed',String(calendarMode===mode));}const grid=$('calendarGrid');grid.className='calendar-grid'+(calendarMode==='month'?' month':'');grid.replaceChildren();if(calendarMode==='month'){for(const label of ['Man','Tir','Ons','Tor','Fre','Lør','Søn']){const d=document.createElement('div');d.className='weekday';d.textContent=label;grid.append(d);}}
const start=calendarMode==='month'?monday(range.start):range.start;const end=calendarMode==='month'?addDays(monday(range.end),6):range.end;const today=dateKey(new Date());for(let date=new Date(start);date<=end;date=addDays(date,1)){const key=dateKey(date),inPlan=key>=currentPlan.start_date&&key<=currentPlan.end_date;const daily=sessions.filter(s=>s.date===key);const day=document.createElement('div');day.className='day'+(key===today?' today':'')+(!inPlan?' outside':'')+(calendarMode==='month'&&date.getMonth()!==anchor.getMonth()?' other-month':'');const heading=document.createElement('div');heading.className='day-heading';heading.textContent=date.toLocaleDateString('nb-NO',{weekday:'short',day:'numeric',month:'numeric'})+(key===today?' · I dag':'');day.append(heading);if(daily.length){const total=document.createElement('div');total.className='day-total';total.textContent=duration(daily.reduce((n,s)=>n+Number(s.planned_min||0),0))+' angitt';day.append(total);}for(const s of daily){const card=document.createElement('article');card.className='session';card.style.setProperty('--sport',COLORS[s.sport]||COLORS.Annet);card.innerHTML=`<div class="session-sport">${esc(sportLabel(s.sport))}</div><div class="session-title">${esc(s.title||'Planlagt økt')}</div><div class="session-details">${esc(metrics(s.planned_km,s.planned_min))}</div>`;const actions=document.createElement('div');actions.className='actions';actions.append(button('Rediger','secondary',()=>editSession(s.id)),button('Kopier','secondary',()=>copySession(s.id)),button('Slett','danger',()=>deleteSession(s.id)));card.append(actions);day.append(card);}if(!daily.length){const p=document.createElement('div');p.className='empty';p.textContent=inPlan?'Ingen økter':'Utenfor planen';day.append(p);}if(inPlan){const target=key;day.append(button('+ Økt','add',()=>prepareSession(target)));}grid.append(day);}renderLegend('calendarLegend',[...new Set(visible.map(s=>s.sport))]);}
function renderLegend(id,sports){$(id).replaceChildren();for(const sport of sports){const label=document.createElement('span');label.style.color=COLORS[sport]||COLORS.Annet;label.textContent=sportLabel(sport);$(id).append(label);}}
function updateFilterChecks(){document.querySelectorAll('#sportFilters input').forEach(c=>c.checked=selectedSports.has(c.value));}
function initFilters(){for(const sport of SPORTS){const label=document.createElement('label');label.className='filter';const input=document.createElement('input');input.type='checkbox';input.value=sport;input.checked=true;input.addEventListener('change',()=>{input.checked?selectedSports.add(sport):selectedSports.delete(sport);renderAnalysis();});label.append(input,document.createTextNode(sportLabel(sport)));$('sportFilters').append(label);}}
function renderAnalysis(){if(!currentPlan)return;const start=$('analysisStart').value,end=$('analysisEnd').value,time=$('metric').value==='time';$('distanceNote').classList.toggle('hidden',time);$('volumeChart').replaceChildren();$('weeklyHead').replaceChildren();$('weeklyBody').replaceChildren();$('chartLegend').replaceChildren();if(!start||!end||end<start||start<currentPlan.start_date||end>currentPlan.end_date){$('analysisNote').textContent='Velg en gyldig periode innenfor planen.';stats('analysisStats',[]);return;}
const selected=SPORTS.filter(s=>selectedSports.has(s));const filtered=sessions.filter(s=>selectedSports.has(s.sport)&&s.date>=start&&s.date<=end);const field=time?'planned_min':'planned_km';const missing=filtered.filter(s=>s[field]==null).length;const weeks=[];for(let d=monday(parseDate(start));dateKey(d)<=end;d=addDays(d,7)){const key=dateKey(d),last=dateKey(addDays(d,6)),iw=isoWeek(d);const values=Object.fromEntries(selected.map(s=>[s,0]));let count=0;for(const s of filtered){if(s.date>=key&&s.date<=last){values[s.sport]+=Number(s[field]||0)/(time?60:1);count++;}}const total=Object.values(values).reduce((a,b)=>a+b,0);weeks.push({key,last,label:`${iw.year} U${iw.week}`,short:`U${iw.week}`,values,total,count,partial:key<start||last>end});}
const total=weeks.reduce((n,w)=>n+w.total,0),peak=weeks.reduce((a,w)=>!a||w.total>a.total?w:a,null),unit=time?'t':'km';stats('analysisStats',[['Volum i valgt periode',number(total,2)+' '+unit],['Snitt per kalenderuke',number(total/(weeks.length||1),2)+' '+unit],['Største uke',peak&&peak.total>0?peak.short+' · '+number(peak.total,2)+' '+unit:'–'],['Økter i utvalget',filtered.length]]);$('analysisNote').textContent=(!selected.length?'Velg minst én idrett. ':filtered.length?'':'Ingen planlagte økter i dette utvalget. ')+`${missing} økter mangler ${time?'varighet':'distanse'} og bidrar med 0 i diagrammet. Tomme uker er med i snittet. `+(weeks.some(w=>w.partial)?'Første eller siste uke er delvis: bare økter innenfor datofilteret telles.':'');renderLegend('chartLegend',selected);drawChart(weeks,selected,time);$('weeklyHead').innerHTML='<tr><th>Uke</th>'+selected.map(s=>'<th>'+esc(sportLabel(s))+'</th>').join('')+'<th>Totalt ('+unit+')</th><th>Endring fra forrige uke</th></tr>';$('weeklyBody').innerHTML=weeks.map((w,i)=>{const prev=weeks[i-1];const change=prev&&prev.total>0?(w.total-prev.total)/prev.total*100:null;return '<tr><td>'+esc(w.label)+(w.partial?' *':'')+'</td>'+selected.map(s=>'<td>'+number(w.values[s],2)+'</td>').join('')+'<td><b>'+number(w.total,2)+'</b></td><td>'+(change===null?'–':(change>0?'+':'')+number(change,1)+' %')+'</td></tr>';}).join('');}
function svgNode(tag,attributes={},text){const node=document.createElementNS('http://www.w3.org/2000/svg',tag);for(const [k,v] of Object.entries(attributes))node.setAttribute(k,String(v));if(text!==undefined)node.textContent=text;return node;}
function drawChart(weeks,sports,time){const width=Math.max(680,weeks.length*65+100),height=310,left=58,right=20,top=35,bottom=60,plotH=height-top-bottom,plotW=width-left-right;const max=Math.max(...weeks.map(w=>w.total),0);const ceiling=max?max*1.15:1;const svg=svgNode('svg',{viewBox:`0 0 ${width} ${height}`,role:'img','aria-label':`Planlagt ukentlig ${time?'treningstid i timer':'distanse i kilometer'}. Detaljer i uketabellen nedenfor.`});svg.style.minWidth=width+'px';const unit=time?'timer':'km';for(let i=0;i<=4;i++){const value=ceiling*i/4,y=height-bottom-plotH*i/4;svg.append(svgNode('line',{x1:left,y1:y,x2:width-right,y2:y,stroke:'#e5ebf3'}));svg.append(svgNode('text',{x:left-8,y:y+4,'text-anchor':'end',fill:'#617187','font-size':11},number(value,2)));}svg.append(svgNode('text',{x:10,y:18,fill:'#617187','font-size':11},unit));const slot=plotW/(weeks.length||1),barW=Math.min(44,slot*.68);weeks.forEach((w,i)=>{const x=left+slot*i+(slot-barW)/2;const group=svgNode('g',{class:'chart-bar',tabindex:0,role:'button','aria-label':`${w.label}: ${number(w.total,2)} ${unit}. Åpne uke.`});const details=[`${w.label}${w.partial?' (delvis uke)':''}: ${number(w.total,2)} ${unit}`,...sports.map(s=>`${s}: ${number(w.values[s],2)} ${unit}`)].join('\n');group.append(svgNode('title',{},details));group.append(svgNode('rect',{x:left+slot*i,y:top,width:slot,height:plotH,fill:'transparent'}));let base=height-bottom;for(const sport of sports){const value=w.values[sport],h=value/ceiling*plotH;if(h>0){group.append(svgNode('rect',{x,y:base-h,width:barW,height:h,fill:COLORS[sport]||COLORS.Annet,rx:2}));base-=h;}}if(w.total>0)group.append(svgNode('text',{x:x+barW/2,y:base-7,'text-anchor':'middle',fill:'#31445b','font-size':11},number(w.total,1)));group.append(svgNode('text',{x:x+barW/2,y:height-bottom+20,'text-anchor':'middle',fill:'#4b6078','font-size':11},w.short+(w.partial?'*':'')));group.append(svgNode('text',{x:x+barW/2,y:height-bottom+37,'text-anchor':'middle',fill:'#8190a3','font-size':10},parseDate(w.key).toLocaleDateString('nb-NO',{day:'numeric',month:'numeric'})));const open=()=>{anchor=parseDate(w.key);calendarMode='week';renderCalendar();$('calendarTitle').scrollIntoView({behavior:'smooth',block:'center'});};group.addEventListener('click',open);group.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();open();}});svg.append(group);});$('volumeChart').append(svg);}
function renderComparison(){const used=new Set(),today=dateKey(new Date());$('compareBody').innerHTML=sessions.map(s=>{const a=activities.find(a=>a.date===s.date&&a.sport===s.sport&&!used.has(a.id));let status=s.date<today?'Ingen aktivitet funnet':'Planlagt',cls=s.date<today?'miss':'',actual='–';if(a){used.add(a.id);actual=metrics(a.distance_km,a.duration_min)+(a.avg_hr?' · '+a.avg_hr+' bpm':'');const ratio=Number(s.planned_km)>0?Number(a.distance_km||0)/Number(s.planned_km):Number(s.planned_min)>0?Number(a.duration_min||0)/Number(s.planned_min):null;status=ratio===null?'Aktivitet funnet':ratio>=.9?'Tilstrekkelig mengde':'Under planlagt mengde';cls=ratio===null||ratio>=.9?'ok':'part';}return `<tr><td>${esc(labelDate(s.date))}</td><td>${esc(sportLabel(s.sport))}</td><td style="white-space:pre-wrap">${esc(s.title)}</td><td>${esc(metrics(s.planned_km,s.planned_min))}</td><td>${esc(actual)}</td><td class="${cls}">${esc(status)}</td></tr>`;}).join('')||'<tr><td colspan="6">Ingen planlagte økter.</td></tr>';$('unmatched').replaceChildren();const other=activities.filter(a=>!used.has(a.id));if(!other.length)$('unmatched').textContent=activities.length?'Alle aktiviteter har en foreslått kobling.':'Ingen importerte aktiviteter i perioden.';for(const a of other){const p=document.createElement('p');p.className='muted';p.textContent=labelDate(a.date)+' · '+sportLabel(a.sport)+' · '+metrics(a.distance_km,a.duration_min);$('unmatched').append(p);}}
function descendants(el,name){return Array.from(el.getElementsByTagNameNS('*',name));}
function tag(el,name){return el?descendants(el,name)[0]?.textContent??null:null;}
function parseTcx(xml){const doc=new DOMParser().parseFromString(xml,'application/xml');if(doc.getElementsByTagName('parsererror').length)throw Error('Ugyldig XML.');const map={Running:'Løping',Biking:'Sykling',Swimming:'Svømming',Other:'Annet'};return descendants(doc,'Activity').map(a=>{const id=tag(a,'Id'),start=new Date(id||'');if(!id||!Number.isFinite(start.getTime()))throw Error('Mangler gyldig starttidspunkt.');let seconds=0,metres=0,cal=0,hrSum=0,hrTime=0,maxHr=0;for(const lap of descendants(a,'Lap')){const t=Number(tag(lap,'TotalTimeSeconds'))||0;seconds+=t;metres+=Number(tag(lap,'DistanceMeters'))||0;cal+=Number(tag(lap,'Calories'))||0;const avg=Number(tag(descendants(lap,'AverageHeartRateBpm')[0],'Value'))||0;const max=Number(tag(descendants(lap,'MaximumHeartRateBpm')[0],'Value'))||0;if(avg>0&&t>0){hrSum+=avg*t;hrTime+=t;}maxHr=Math.max(maxHr,max);}if(seconds<0||metres<0)throw Error('Negativ varighet eller distanse.');return {external_id:id,started_at:start.toISOString(),date:dateKey(start),sport:map[a.getAttribute('Sport')]||'Annet',duration_min:Number((seconds/60).toFixed(2)),distance_km:Number((metres/1000).toFixed(3)),avg_hr:hrTime?Math.round(hrSum/hrTime):null,max_hr:maxHr||null,calories:Math.round(cal)||null};});}
async function importFiles(e){if(!user)return;const input=e.target,files=Array.from(input.files||[]);if(!files.length)return;input.disabled=true;const uid=user.id;try{const unique=new Map();for(const file of files){let rows;try{rows=parseTcx(await file.text());if(!rows.length)throw Error('Ingen aktiviteter funnet.');}catch(error){throw Error(file.name+': '+error.message+' Ingen filer fra forsøket ble lagret.');}for(const row of rows)unique.set(row.external_id,{...row,user_id:uid});}if(user?.id!==uid)return;const {error}=await sb.from('activities').upsert([...unique.values()],{onConflict:'user_id,external_id'});if(error)throw error;if(currentPlan)await openPlan(currentPlan.id);show(unique.size+' aktivitet(er) importert eller oppdatert.');}finally{input.disabled=false;input.value='';}}
async function init(){try{if(!window.supabase)throw Error('Kunne ikke laste Supabase. Sjekk nettilkoblingen og last siden på nytt.');sb=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);for(const sport of SPORTS){const option=document.createElement('option');option.value=sport;option.textContent=sportLabel(sport);$('sSport').append(option);}initFilters();bind('authForm','submit',e=>{e.preventDefault();return auth(false);});bind('signup','click',()=>auth(true));bind('logout','click',async()=>{const {error}=await sb.auth.signOut();if(error)throw error;applyUser(null);$('message').classList.add('hidden');});bind('planForm','submit',createPlan);bind('sessionForm','submit',saveSession);bind('cancelEdit','click',resetEditor);bind('fileInput','change',importFiles);bind('previous','click',()=>moveCalendar(-1));bind('next','click',()=>moveCalendar(1));bind('today','click',()=>{anchor=parseDate(dateKey(new Date()));renderCalendar();});bind('weekView','click',()=>{calendarMode='week';renderCalendar();});bind('monthView','click',()=>{calendarMode='month';renderCalendar();});for(const id of ['metric','analysisStart','analysisEnd'])bind(id,'change',renderAnalysis);bind('allSports','click',()=>{selectedSports=new Set(SPORTS);updateFilterChecks();renderAnalysis();});bind('noSports','click',()=>{selectedSports.clear();updateFilterChecks();renderAnalysis();});bind('wholePlan','click',()=>{if(!currentPlan)return;$('analysisStart').value=currentPlan.start_date;$('analysisEnd').value=currentPlan.end_date;renderAnalysis();});bind('visiblePeriod','click',()=>{if(!currentPlan||!anchor)return;const range=calendarRange(),start=dateKey(range.start),end=dateKey(range.end);const from=start>currentPlan.start_date?start:currentPlan.start_date,to=end<currentPlan.end_date?end:currentPlan.end_date;if(to<from)throw Error('Kalenderperioden ligger utenfor planen.');$('analysisStart').value=from;$('analysisEnd').value=to;renderAnalysis();});const {data,error}=await sb.auth.getSession();if(error)throw error;applyUser(data.session?.user||null);sb.auth.onAuthStateChange((_event,session)=>{setTimeout(()=>applyUser(session?.user||null),0);});}catch(error){$('loading').classList.add('hidden');fail(error);}}
init();
</script>
