s:repeat(4,minmax(0,1fr));gap:12px}.form-grid input,.form-grid select{width:100%;min-width:0}.wide{grid-column:1/-1}.auth{max-width:440px;margin:30px auto}.auth label{margin-bottom:15px}.auth input{width:100%}.message{padding:14px;border-radius:9px;margin-bottom:18px;white-space:pre-wrap}.message.error{background:#fff0f0;color:#9c2525}.message.success{background:#edf9ef;color:#166534}.calendar-toolbar{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px}.calendar-toolbar h2{margin-bottom:5px}.calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8px;margin-top:16px}.day{min-width:0;min-height:220px;padding:9px;background:#f8fafc;border:1px solid var(--line);border-radius:10px;display:flex;flex-direction:column;gap:8px}.day.today{border:2px solid #2563eb;background:#eff6ff}.day.outside{background:#edf1f5}.day.other-month{opacity:.62}.day-heading{font-size:13px;font-weight:750;text-transform:capitalize}.day-total{font-size:11px;color:var(--muted)}.session{border:1px solid #e0e7ef;border-left:4px solid var(--sport);padding:9px;background:white;border-radius:8px;overflow-wrap:anywhere}.session-sport{color:var(--sport);font-size:12px;font-weight:750}.session-title{font-size:13px;font-weight:650;white-space:pre-wrap;margin-top:5px}.session-details{color:#52647a;font-size:12px;margin-top:6px}.session .actions{gap:4px;margin-top:8px}.session button{font-size:10px;padding:4px 5px}.add{margin-top:auto;background:transparent;color:var(--blue);border:1px dashed #9cacc0;padding:7px 4px;font-size:12px}.empty{color:var(--muted);font-size:12px}.month .day{min-height:160px}.month .session{padding:6px}.month .session-title{font-size:12px}.month .session .actions{display:none}.month .session:hover .actions,.month .session:focus-within .actions{display:flex}.legend{display:flex;flex-wrap:wrap;gap:12px;font-size:12px;margin-top:14px}.weekday{font-size:12px;font-weight:700;color:#63748a;text-align:center}.filters{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.filter{display:flex;flex-direction:row;align-items:center;gap:7px;border:1px solid var(--line);border-radius:20px;padding:8px 11px;cursor:pointer;font-size:12px}.filter input{width:16px;height:16px;margin:0;accent-color:var(--blue)}.filter:has(input:checked){background:#edf4fc;border-color:#91afd0}.chart-scroll{overflow-x:auto;border:1px solid #e5ebf3;border-radius:10px;background:#fff;margin-top:15px}.chart-scroll svg{display:block;width:100%;min-width:650px;height:auto}.chart-bar{cursor:pointer}.chart-bar:hover{opacity:.8}.table-scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:13px}td,th{text-align:left;padding:10px;border-bottom:1px solid #e6edf4;vertical-align:top}th{color:#5d6d84;font-size:12px}.ok{color:#15803d}.part{color:#a35b00}.miss{color:#a32626}summary{cursor:pointer;font-weight:650}.note{background:#fff8e8;color:#7f5b14;border-radius:8px;padding:10px;font-size:13px;line-height:1.5}#sessionEditor{scroll-margin-top:20px}.section-space{margin-top:16px}.mobile-note{display:none}
