function renderAnalysis(){if(!currentPlan)return;const start=$('analysisStart').value,end=$('analysisEnd').value,time=$('metric').value==='time';$('distanceNote').classList.toggle('hidden',time);$('volumeChart').replaceChildren();$('weeklyHead').replaceChildren();$('weeklyBody').replaceChildren();$('chartLegend').replaceChildren();if(!start||!end||end<start||start<currentPlan.start_date||end>currentPlan.end_date){$('analysisNote').textContent='Velg en gyldig periode innenfor planen.';stats('analysisStats',[]);return;}
